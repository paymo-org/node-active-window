{
  "name": "@paymoapp/active-window",
  "version": "2.2.0",
  "type": "module",
  "description": "NodeJS library using native modules to get the active window and some metadata (including the application icon) on Windows, MacOS and Linux.",
  "main": "./dist/index.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install": "node -e \"\"",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "clean": "hereby clean",
    "build": "hereby build",
    "build:ts": "hereby build:ts",
    "prebuildify": "hereby prebuildify",
    "generate:readme-toc": "markdown-toc -i --bullets=\"-\" --maxdepth=4 README.md",
    "release": "commit-and-tag-version",
    "release:pre": "commit-and-tag-version --prerelease"
  },
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "prebuilds/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paymo-org/node-active-window"
  },
  "keywords": [
    "node",
    "native",
    "active",
    "window"
  ],
  "author": "Paymo SRL",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "execa": "^10.0.1",
    "hereby": "^1.15.2",
    "markdown-toc": "^1.2.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "prebuildify": "^6.0.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  }
}
